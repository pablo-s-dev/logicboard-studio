{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogicBoard Studio",
  "version": "0.4.0",
  "identifier": "dev.logicboard.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "LogicBoard Studio", "width": 1500, "height": 920, "minWidth": 1100, "minHeight": 720 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/ghdl": "ghdl",
      "templates": "templates"
    }
  }
}
